NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=https://your-domain.example
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
# Development only: lets the UI render outside Telegram (personal actions stay local/dev-only).
NEXT_PUBLIC_TELEGRAM_DEV_MODE=false

# Surface rollout. Values are server-only and enabled only by the exact string "true".
# Enable in order: MINI_APP, then SITE, then ADMIN. SITE requires MINI_APP;
# ADMIN requires both MINI_APP and SITE.
SITE_V2_ENABLED=false
MINI_APP_V2_ENABLED=false
ADMIN_V2_ENABLED=false

# Public booking abuse protection and privacy-safe rate limiting.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_HMAC_SECRET=
# Local E2E only; never enable the mock in production.
ALLOW_TURNSTILE_MOCK=false
TURNSTILE_MOCK_TOKEN=
NEXT_PUBLIC_TURNSTILE_MOCK_TOKEN=

# Daily privacy-retention endpoint authentication.
CRON_SECRET=

# Optional public contact channels. Empty values are hidden from the site.
NEXT_PUBLIC_CLUB_TELEGRAM_URL=
NEXT_PUBLIC_CLUB_PHONE=
